# Required
MONGO_URI=
FTC_API_KEY=

# FTC publishes weekday data around noon US Eastern time.
SYNC_TIME_ZONE=America/New_York
SYNC_HOUR=13
SYNC_MINUTE=0
SYNC_RUN_ON_BOOT=true

# /health returns 503 when the last successful sync is older than this limit.
HEALTH_MAX_SYNC_AGE_HOURS=48

HTTP_PORT=3000
HTTP_HOST=127.0.0.1
HTTP_CORS_ORIGIN=*
# Set 1 behind nginx, 0 when the service is exposed directly, and 2 behind an LB plus nginx.
HTTP_TRUST_PROXY=1

# Docker Compose only
HOST_PORT=3003
