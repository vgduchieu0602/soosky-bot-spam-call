# MongoDB database used for the DNC complaints warehouse.
MONGO_URI=
MONGO_MAX_POOL_SIZE=5

# Create an API key at https://api.data.gov/signup/ and keep it secret.
FTC_API_KEY=
FTC_API_URL=https://api.ftc.gov/v0/dnc-complaints
FTC_FETCH_TIMEOUT_MS=30000
FTC_FETCH_RETRIES=3
FTC_REQUEST_DELAY_MS=150

# The FTC normally publishes weekday data around noon US Eastern time.
SYNC_TIME_ZONE=America/New_York
SYNC_HOUR=13
SYNC_MINUTE=0
SYNC_RUN_ON_BOOT=true
# Re-fetch this many local calendar days on every run. The unique FTC id makes it safe.
SYNC_LOOKBACK_DAYS=3

# GET /health trả 503 STALE_DATA khi lần sync thành công cuối cùng cũ hơn ngưỡng này.
HEALTH_MAX_SYNC_AGE_HOURS=48

HTTP_PORT=3000
HTTP_HOST=0.0.0.0
# Use * for a public FE, or a comma-separated allow-list of origins.
HTTP_CORS_ORIGIN=*
