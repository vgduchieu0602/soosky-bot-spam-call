{
  "info": {
    "_postman_id": "5c6d4ffd-7d49-475b-8b4c-84484ca893ab",
    "name": "Soosky Bot Spam Call API",
    "description": "FTC spam-call data API. Select the Local or Production environment before sending requests. See docs-share/API.md for the full contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://project5.vuonghieu.site"
    },
    {
      "key": "phone",
      "value": "2025550111"
    },
    {
      "key": "from",
      "value": "2026-01-01"
    },
    {
      "key": "to",
      "value": "2026-12-31"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Returns 200 when Mongo is connected and the latest successful FTC sync is fresh. 503 is a valid operational response while the first sync is pending or data is stale."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns JSON response envelope', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Phone lookup",
      "item": [
        {
          "name": "Complaint history by phone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/complaints?phone={{phone}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "complaints"],
              "query": [
                { "key": "phone", "value": "{{phone}}" }
              ]
            },
            "description": "Returns the reputation summary (complaintCount, lastComplaintAt) and detailed complaints for one phone, newest first. Each item has reportedAt: the FTC report time in UTC. The API returns all matching complaints."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Returns complete complaint history', () => {",
            "    pm.response.to.have.status(200);",
            "    const data = pm.response.json().data;",
            "    pm.expect(data).to.have.property('complaintCount');",
            "    pm.expect(data.items).to.be.an('array');",
            "    if (data.items.length > 0) pm.expect(data.items[0]).to.have.property('reportedAt');",
            "    pm.expect(data).to.have.property('lastComplaintAt');",
            "});"
          ] } }]
        },
        {
          "name": "Complaint history by phone and date range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/complaints?phone={{phone}}&from={{from}}&to={{to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "complaints"],
              "query": [
                { "key": "phone", "value": "{{phone}}" },
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" }
              ]
            },
            "description": "Optional date range. The response still contains complaintCount, lastComplaintAt, and all matching detailed complaints."
          }
        }
      ]
    },
    {
      "name": "Spam number list",
      "item": [
        {
          "name": "List all known spam numbers - first page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/spam-numbers?page=1&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "spam-numbers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "All database data, paginated by page/limit. total is the number of unique E.164 phone numbers, not the number of complaint documents."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Returns a paginated number list', () => {",
            "    pm.response.to.have.status(200);",
            "    const data = pm.response.json().data;",
            "    pm.expect(data).to.have.property('total');",
            "    pm.expect(data).to.have.property('page');",
            "    pm.expect(data).to.have.property('totalPages');",
            "    pm.expect(data.items).to.be.an('array');",
            "    pm.expect(data.items.length).to.be.at.most(100);",
            "});"
          ] } }]
        },
        {
          "name": "List by date range and minimum complaints",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/spam-numbers?from={{from}}&to={{to}}&minComplaints=3&page=1&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "spam-numbers"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "minComplaints", "value": "3" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "from/to and minComplaints are optional filters. Results are ordered by complaintCount descending, then lastComplaintAt descending."
          }
        },
        {
          "name": "List spam numbers - second page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/spam-numbers?page=2&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "spam-numbers"],
              "query": [
                { "key": "page", "value": "2" },
                { "key": "limit", "value": "100" }
              ]
            },
            "description": "Example of the next page. Increase page by 1 until page is greater than totalPages."
          }
        }
      ]
    },
    {
      "name": "Phone fragment search",
      "item": [
        {
          "name": "Search numbers containing a digit fragment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?phone=01234",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [{ "key": "phone", "value": "01234" }]
            },
            "description": "Requires 3 to 15 digits. Returns every unique E.164 number that contains the requested digit fragment, with complaintCount and lastComplaintAt."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Returns matching phone number details', () => {",
            "    pm.response.to.have.status(200);",
            "    const data = pm.response.json().data;",
            "    pm.expect(data).to.have.property('total');",
            "    pm.expect(data.items).to.be.an('array');",
            "});"
          ] } }]
        },
        {
          "name": "Search fragment too short - 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/search?phone=12",
            "description": "Expected: 400 INVALID_PHONE_SEARCH."
          }
        }
      ]
    },
    {
      "name": "Validation errors",
      "item": [
        {
          "name": "Invalid phone - 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/complaints?phone=abc",
            "description": "Expected: 400 INVALID_PHONE_NUMBER."
          }
        },
        {
          "name": "Invalid date range - 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/spam-numbers?from=2026-08-31&to=2026-08-01",
            "description": "Expected: 400 INVALID_DATE_RANGE."
          }
        }
      ]
    }
  ]
}
